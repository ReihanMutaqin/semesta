rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read & write for Data Semesta Dashboard
    match /summary/{document} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
